## Interface: 120100
## Title: ThugUI
## Notes: Enhanced UI features including per-spec cursor-anchored cooldown grids
## Author: Thug
## Version: 1.1.0
## IconTexture: Interface\AddOns\ThugUI\media\Acorn
## SavedVariables: ThugUI_Config ThugUI_DebugLog ThugUI_BCVDump ThugUIDB

ThugUI.xml

# core.lua MUST load before any module: it creates ThugUI.modules, defines
# ThugUI:RegisterModule (called at file scope by OrbAnchors), and owns the
# ADDON_LOADED handler that runs InitializeDB + every module's Initialize.
# It assigns ThugUI.modules = {} unconditionally, so loading it after a module
# has registered would wipe the registry.
core.lua

# Diagnostics loads early so every module below can call ThugUI.Diagnostics:Log
# without guarding for load order. Always on, silent, writes to ThugUI_DebugLog.
modules\Diagnostics.lua

# oUF (MIT) - vendored unit frame framework, see libs\oUF\LICENSE.txt.
# Embedded with no X-oUF metadata, so it exposes no global and is reached
# through the addon namespace as ns.oUF. Must load before anything using it.
libs\oUF\oUF.xml

# Config window framework. Widgets before Window (Window builds panels from it),
# and both before anything in ui\pages, which registers itself at file scope.
ui\Widgets.lua
ui\Window.lua

modules\EssentialRings.lua
modules\EssentialRings_Settings.lua

# Target of target: Core defines ThugUI.TargetOfTarget and Settings hangs its
# panel off the helpers exported by EssentialRings_Settings, so both come
# after that file.
modules\TargetOfTarget\Core.lua
modules\TargetOfTarget\Settings.lua

modules\FrameHider.lua

# Resource ring: attaches to ThugUI_CursorFrame and borrows the cast ring's
# geometry, so it must load after EssentialRings defines both.
modules\ResourceRing.lua

# Combo pips: the class's secondary resource as dots around the same ring, so
# it sizes itself off ER.CastFrame too and is initialised alongside the ring.
modules\ComboPips.lua

# Cooldown viewer: the generic per-spec grid engine that supersedes the
# ECV/BCV/GCV bars in EssentialRings.lua. Data holds the profiles and the spell
# catalogue; Core renders them. Loads after EssentialRings because its one-time
# migration reads that file's legacy spell definitions.
modules\CooldownViewer\Data.lua
modules\CooldownViewer\Core.lua

# Blizzard's own buff item frames, anchored into our grid cells. Loads after
# Core because it reads CV.icons and hangs itself off CV.
modules\CooldownViewer\BlizzBuffs.lua

# Secret probe: records which 12.x APIs hand this addon a readable value, a
# secret, or nothing, at five points around combat. Loads after CooldownViewer
# because it probes the aura-mode icons actually placed in the active spec.
modules\SecretProbe.lua

# Pages for the config window. Each registers itself on load, so every module it
# configures must already be defined above.
#
# The buff workaround guide is a panel hung off the config window, not a page:
# it defines CV.BuffGuide at file scope and the Cooldown Viewer page builds its
# link from it, so it has to load before that page (and after ui\Widgets.lua,
# whose AttachTooltip it uses).
ui\pages\CooldownViewerGuide.lua
ui\pages\CooldownViewer.lua
ui\pages\OrbAnchors.lua
ui\pages\FrameHider.lua
ui\pages\CursorRings.lua
ui\pages\TargetOfTarget.lua
ui\pages\About.lua

options.lua
modules\OrbAnchors.lua
